{
  "name": "@yomni/plugin-wallpaper-engine",
  "version": "1.3.9",
  "type": "module",
  "license": "MIT",
  "description": "Local and live wallpapers, liquid glass, and appearance controls for Yomni.",
  "files": [
    "yomni-manifest.json",
    "dist",
    "LICENSE",
    "NOTICE",
    "assets"
  ],
  "scripts": {
    "build": "node scripts/build-yomni.mjs && yomni-plugin-build .",
    "pack": "yomni-plugin pack .",
    "test": "node --test test/yomni-*.test.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "node ../../yomni/tools/workspace.mjs dev --plugin ."
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@yomni/contracts": "file:vendor/yomni-devkit/yomni-contracts-0.1.0.tgz",
    "@yomni/plugin-build": "file:vendor/yomni-devkit/yomni-plugin-build-0.1.0.tgz",
    "@yomni/plugin-sdk": "file:vendor/yomni-devkit/yomni-plugin-sdk-0.1.0.tgz",
    "@yomni/ui": "file:vendor/yomni-devkit/yomni-ui-0.1.0.tgz",
    "esbuild": "^0.25.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2"
  },
  "yomni": {
    "id": "yomni.wallpaper-engine",
    "apiVersion": 1,
    "runtime": "node",
    "manifest": "./yomni-manifest.json"
  },
  "exports": "./dist/index.cjs",
  "publishConfig": {
    "access": "public"
  }
}
