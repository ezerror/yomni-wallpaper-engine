{
  "name": "@anypal/plugin-wallpaper-engine",
  "version": "1.3.9",
  "type": "module",
  "license": "MIT",
  "description": "Local and live wallpapers, liquid glass, and appearance controls for Pal.",
  "files": ["pal-manifest.json", "dist", "LICENSE", "NOTICE"],
  "scripts": {
    "build": "node scripts/build-pal.mjs && pal-plugin-build .",
    "pack": "pal-plugin pack .",
    "test": "node --test test/pal-*.test.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "node ../../pal/tools/workspace.mjs dev --plugin ."
  },
  "devDependencies": {
    "@anypal/contracts": "0.1.0",
    "@anypal/plugin-build": "0.1.0",
    "@anypal/plugin-sdk": "0.1.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2"
  },
  "pal": {
    "id": "pal.wallpaper-engine",
    "apiVersion": 1,
    "runtime": "node",
    "manifest": "./pal-manifest.json"
  },
  "exports": "./dist/index.cjs",
  "publishConfig": { "access": "public" }
}
