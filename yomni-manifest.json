{
  "title": "Wallpaper Engine",
  "author": "elysia395 / Yomni adaptation",
  "category": "appearance",
  "icon": "data:image/png;base64,",
  "workspaceTargets": [
    "local",
    "ssh"
  ],
  "permissions": [
    "yomni.host.inject",
    "yomni.storage.read",
    "yomni.storage.write",
    "yomni.fs.read",
    "yomni.fs.write",
    "yomni.process.spawn",
    "yomni.network.fetch"
  ],
  "declarations": {
    "provides": {
      "ui": [
        {
          "id": "yomni.wallpaper-engine.connection",
          "slot": "yomni.ui.panel",
          "description": "Provide the host injection with the wallpaper service connection"
        }
      ]
    }
  },
  "extensions": [
    "yomni.ui.panel",
    "yomni.ui.settings"
  ],
  "frontends": {
    "assets": {
      "root": "dist/ui",
      "entry": "index.html"
    }
  },
  "settings": {
    "title": "Wallpaper Engine",
    "frontend": "assets",
    "renderMode": "host-injection",
    "width": "wide",
    "locales": {
      "zh-CN": {
        "title": "壁纸引擎"
      }
    }
  },
  "hostInjection": {
    "frontend": "assets",
    "script": "host.js",
    "stylesheet": "host.css"
  },
  "locales": {
    "zh-CN": {
      "name": "动态壁纸引擎",
      "description": "本地壁纸、实时场景、液态玻璃、字体及外观设置。"
    }
  }
}
